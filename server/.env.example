# Copy to .env and fill in. Never commit the real .env.

PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Database name inside the cluster (keeps this site separate from other apps)
MONGO_DB_NAME=mrlionx

# Cloudinary, for image uploads from the admin dashboard
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_FOLDER=mrlionx

# Admin dashboard login (the site's /admin page)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random string used to sign login tokens. Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed to call the API (no trailing slashes)
CLIENT_URL=https://mr-lion-x.vercel.app,http://localhost:5173

# Optional: email notification for new enquiries (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=binethellepola@gmail.com

# Optional: override DNS if mongodb+srv lookups fail locally (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
